],"synthesis":null,"freshness":null,"notes":null,"tier":"ai_signal","research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2019-10-01","rate":5.0,"source":"urfire_2022","dims":{"identification":"化工系的副教授，但拥有自己的研究室。本硕博东京大学，博士毕业后在台湾成功大学工作过近十年，英文极其流利，中文也很标准。","academics":"在日本学术界很活跃，目前研究方向主要是工业生态学与机器学习的结合（2019年）。对学生的学术方面要求比较严格，但不会辱骂学生。思考问题很有逻辑，指导学生有耐心也很细致。","funding":"经常鼓励学生去参加学会，会为成员配置电脑显示屏和可能需要的正版软件，科研经费比较充裕。","stipend":"会鼓励学生做RA等工作提高收入，本研究室做RA约为2w日元一个月，奖学金等也会帮忙争取。","relationship":"研究室氛围和谐融洽并且相当愉快，完全没有欺凌和歧视，平时师生聊天也有梗，很轻松的感觉，有成员英语，学术等方面可能跟不太上的时候，大家还会私下想办法帮忙，这个是我觉得很温馨的一点。","workload":"一般默认上午之前来，晚饭走，但不打卡，来得晚问题不大，不来的时候研究室内部邮件提前通知一下即可，非常弹性。","outcome":"允许学生实习。在学术界人脉较广，但在工业界并不是很了解。"}}],"alias":null},{"id":"ad46eb91cc","supervisor":"久保百司","university":"东北大学(日本)","dir_bucket":"未标注","departments":["无"],"n_reviews":1,"rate_avg":2.0,"dates":["2020-02-01","2020-02-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{},"dims_n":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":null,"base":null,"penalty":null,"penalties":[],"parts":[],"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2020-02-01","rate":2.0,"source":"urfire_2022","dims":{"identification":"金属研究所二号馆七楼","academics":"堪忧，因为是京都大学化学系出身，对金属，陶瓷一窍不通，本人也并不热爱学术","funding":"擅长写申请书拉经费。相应的学生要拼命做项目参加各种学术会议帮他结项目凑业绩","stipend":"无","relationship":"日本学生叫他人渣，读他博士的人非常少。2016-2019年连续招了5名中国女留学生，平时吃饭拍集体合影都要女学生和女职员站在他旁边。喜欢只带女生出去开会，并有边缘性迷惑举动。喜欢发表zang独tai独gang独言论。种族歧视严重。","workload":"无固定时间，但每年参加学会的数量是指定的。","outcome":"掌控欲强，博士被卡实习严重，改论文极慢，并由于自身水平问题难出高质量论文。"}}],"alias":null},{"id":"a7147155bc","supervisor":"佐竹保子","university":"东北大学(日本)","dir_bucket":"未标注","departments":["无"],"n_reviews":1,"rate_avg":null,"dates":["2018-11-01","2018-11-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{},"dims_n":{},"internship":{"score":