":{"mentions":3,"hard":true,"keywords":{"毕不了业":1,"退学":2},"delay":0},"direction":null,"composite":-3.73,"base":2.27,"penalty":6,"penalties":[{"label":"退学/劝退硬信号","pts":-6}],"parts":[{"k":"sev","label":"七维口碑均分","v":2.62,"w":0.55},{"k":"dropout","label":"退学风险","v":1,"w":0.15}],"basis":"review","academics_profile":null,"outcome_profile":null,"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2019-12-01","rate":1.25,"source":"urfire_2022","dims":{"identification":"大黑眼圈，你懂得","academics":"毕竟博士，可以给两颗星，但是他现在做的都是啥试验内容？天马行空不切实际，做个吸附能提高百分之一的吸附量（不排除实验误差）他都觉得是有效果。。。","funding":"没有，全靠厚着脸皮添别的老师的课题经费","stipend":"你要孝敬他，他不会给你一毛钱（对了，如果你有被虐或者喜欢被骂觉得被骂能提高你的脸皮厚度的变态嗜好，他给你的这方面补助很大的）","relationship":"临时带的学生都被骂走，自己带的唯一一个学生都被骂走，甚至一度想退学","workload":"学生晚一分钟来实验室你就等着被全楼通骂吧，他？他自己想来就来","outcome":"有冇前途，毕业都成问题，你做实验他都想防贼一样防着你呢"}},{"date":"2018-12-01","rate":1.0,"source":"urfire_2022","dims":{"identification":"湘大环保楼资深人员","academics":"都是吹的，喜欢炫自己曾经做的材料，发的文章多牛逼，却不认真指导学生","funding":"不要脸地蹭大导师的经费，带的大导师的学生，没有一个能做出点名堂，最后都无例外都被骂回自己的课题组了","stipend":"是学生得孝敬他这个洋大爷啊","relationship":"极度恶劣，不尊重学生，尤其是女学生","workload":"满的","outcome":"跟的学生还是自己退学吧"}},{"date":"2018-12-01","rate":1.0,"source":"urfire_2022","dims":{"identification":"环保楼前辈","academics":"似是而非，沈J全靠一张嘴","funding":"自己又申请不了，于是靠蹭","stipend":"或许曾经承诺过有吧","relationship":"沈J是典型的人身攻击型人格，喜欢在公开场合，群里骂人，口无遮拦","workload":"自己可以很随意","outcome":"一个把学生称为底层人员的老师，自行感受吧"}},{"date":"2018-09-01","rate":1.0,"source":"urfire_2022","dims":{"identification":"沈J17年09月入职湘大环资院，仗着北京中科院过程所读的博，去美国堪萨斯大学读的博后，就目空一切，一副自己最牛的嘴脸。对待大导师，院领导如狗一样跪舔，而对待学生一副趾高气扬，你们是来求我，必须像孙子一样听他指挥，对于这种两面派的人渣老师，必须要揭露出来，避免更多人受害！","academics":"沈J读博主攻絮凝材料，博后主攻纳米材料，喜欢提一些天马行空的实验想法，做不下去也要逼着学生实施自己的想法，更恶心的是生怕别人偷学自己的知识，一副防学生如防贼的狗样。比如由于他刚入职，加入某戴姓大导师的大课题组，因为他第一年没带研究生，为了捞一点学术成果，主动讨好某戴姓大导师，帮她的高年级研究生改英文论文，以及指导她低年级研究生做自己的实验方向；结果，一年后高年级研究生的英文论文由于被不真心指导而被耽误不能发表，还指责挖苦学生不配合，还有被指导实验的低年级研究生也一直无法将实验做下去，而他平时只会打发学生自己读文献解决，不给予真心指导。还比如他为了讨好某陈姓实验主任，主动分担几个他带毕业实验的学生做自己的实验方向，后来却在群里威胁这几个本科生要在2个月之内凑齐1篇SCI的数据量，连研究生都无法在这么短时间内做到，凭几个本科生能做到吗，只能呵呵了；最后，在被耽误一个月后，这几个本科生只能换老师重做毕业实验。<br> 这样的事情太多了，沈J只想着自己要多么多么地牛逼，不会帮助学生一起进步，尤其是对待其他导师的学生，而等到18年09月他的第一个研究生过来，估计3年后不出5个以上的学术成果，他是毕不了业的。","funding":"沈J由于是新入职的大学讲师，没有自己的科研经费，所以他于17年末到18年初与几个外校老师一起联合申请了中山大学的科研经费，另人恶心的是在科研经费受益人一栏几乎写了所有环保楼的老师，唯独故意不加上自己现在待的大课题组的某戴姓大导师的名字，最后被其他相关人士网上批露出来，对此只能服了他所谓的利益关系。（附：他曾经想利用带某戴姓大导师研究生的情况，想套取科研经费，结果被拒后心怀不满；还有，他现在傍上环资院某张姓院长，故伎重施，利用带他的研究生实验来套取他的科研经费，也是狗改不了吃屎！）","stipend":"想什么呢，这个铁公鸡一毛不拔，他还想着学生应该孝敬他！","relationship":"他可以完美地跟所有的本科生，以及研究生相处不好，以后你们可以自行体会！","workload":"允许自己早上9，10点以后上班，却要求学生早上8点到晚上10点必须待实验室，永远严于要求别人！","outcome":"本科生毕业实验绝对完成不了，可以读大五了！<br>研究生发不了N篇SCI不给签字毕业，可以选择退学！"}}],"alias":null},{"id":"a7b0d67c48","supervisor":"孙立忠","university":"湘潭大学","dir_bucket":"其他学科（非AI）","departments":["材料科学与工程学院"],"n_reviews":1,"rate_avg":null,"dates":["2018-09-01","2018-09-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{},"dims_n":{},"dims_ai":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":null,"base":null,"penalty":null,"penalties":[],"parts":[],"basis":null,"academics_profile":null,"outcome_profile":null,"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2018-09-01","rate":0.0,"source":"urfire_2022","dims":{"identification":"经常不在学校，博导，教授"}}],"alias":null},{"id":"a2203189f2","supervisor":"尹付成","university":"湘潭大学","dir_bucket":"其他学科（非AI）","departments":["材料科学与工程学院"],"n_reviews":1,"rate_avg":null,"dates":["2018-09-01","2018-09-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{},"dims_n":{},"dims_ai":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":null,"base":null,"penalty":null,"penalties":[],"parts":[],"basis":null,"academics_profile":null,"outcome_profile":null,"synthesis":null,"freshness