毕业实习是不要想的，能顺利毕业都是烧香拜佛了，能做工作也基本是农残检测等工作，或者学生自己找其他的工作，就本专业来说工作很一般，工资待遇差"}}],"alias":null},{"id":"a436665cb5","supervisor":"朱梅","university":"安徽农业大学","dir_bucket":"未标注","departments":["工学院"],"n_reviews":1,"rate_avg":3.5,"dates":["2020-04-01","2020-04-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{"workload":1.0},"dims_n":{"workload":1},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":1.0,"base":1.0,"penalty":0,"penalties":[],"parts":[{"k":"sev","label":"七维口碑均分","v":1.0,"w":0.55}],"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2020-04-01","rate":3.5,"source":"urfire_2022","dims":{"identification":"办公室在三教二楼，身高1.65左右，讲话一般是普通话偶尔带点蚌埠口音","academics":"学术能力还可以，手头有项目，能对学生学术和心理进行双重锻炼","funding":"科研经费比较充足，项目也不少，只要有合理的想法，能够做出东西，一切都好说","stipend":"1k","relationship":"管理一般，对学生好的时候还不错，但是有时候学生有一些令人不满的话就会被训斥的很惨","workload":"早八晚七，活多时候早八晚十，一般周末单休（给你单休你敢不来吗？）有节假日，一般年前三四天放假吧，忙的时候无休无节假日。","outcome":"可以，就工作方面，完全不用担心找不到工作，能够正常毕业就可以找到工作，也会帮你找工作为你推荐。或者更进一步读博也是好选择"}}],"alias":null},{"id":"aa3c970ad6","supervisor":"江海洋","university":"安徽农业大学","dir_bucket":"未标注","departments":["生命科学学院"],"n_reviews":1,"rate_avg":2.0,"dates":["2018-04-01","2018-04-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{},"dims_n":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":null,"base":null,"penalty":null,"penalties":[],"parts":[],"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2018-04-01","rate":2.0,"source":"urfire_2022","dims":{"identification":"带本科生《遗传学》，东北人。","academics":"还可以，在农大算最早能发3分以上文章的人。","funding":"副院长，够呗。","relationship":"学生能达到毕业条件后做的工作就压着不给发了，等学生毕业了，文章就归他老婆了，他老婆跟他一个学院。"}}],"alias":null},{"id":"a739e58edb","supervisor":"程备久","university":"安徽农业大学","dir_bucket":"未标注","departments":["生命科学学院"],"n_reviews":1,"rate_avg":4.5,"dates":["2018-03-01","2018-03-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{},"dims_n":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":null,"base":null,"penalty":null,"penalties":[],"parts":[],"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2018-03-01","rate":4.5,"source":"urfire_2022","dims":{"identification":"声音洪亮，中气十足，头发稀疏。","academics":"程老师对大方向的眼光还是很独到的。现任农大的校长，行政的任务更加繁忙，所以科研课题的细节还是更多的得靠学生自己。程老师还是很重视实验室学术水平的，大PI下的小PI里在这几年招了不少学术很好的人进来，学生进去可以多找实验室其他老师交流。","funding":"国家重点工程实验室，而且职务在那，经费妥妥的。但是现在改革为了提升效率，各小PI经费独立，有课题的多拿，没课题的少拿，所以只要有课题有想法有成果，钱还是很够的。","stipend":"正常水平。但下田有下田补助。农大比较不好的一点是工资发放时间全靠缘分，不是按月定时发，基本导师的部分学期末一次性发放。国家的部分学期中一次，学期末一次分两次发放，一年发10个月的。希望这点以后可以改革。","relationship":"程老板为人严厉，但处处为都学生着想。属于为人刚直，不怒自威的类型。即使发火了，也是过后照样给你找出路谋幸福，哈哈哈！所以做的不好挨训是肯定的，但是记住笑脸相对、诚恳认错这两个窍门，程老师一般都发火不起来。","workload":"农大5，6年前普遍很懒撒，但是现在抓的比较严了。但是每周单休，节假日放假还是妥妥的，周边吃喝玩都近，休息时间基本满足生活需求了。","outcome":"虽然程老师平时行政的办公室待的长实验室来的少，但毕业的学生一般都会主动给你安排出路的，科研的会推荐，工作的也会尽力给安排编制。"}}],"alias":null},{"id":"a104f42006","supervisor":"赵剑","university":"安徽农业大学","dir_bucket":"其他学科（非AI）","departments":["茶与食品科技学院"],"n_reviews":1,"rate_avg":1.0,"dates":["2020-01-01","2020-01-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{},"dims_n":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":null,"base":null,"penalty":null,"penalties":[],"parts":[],"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2020-01-01","rate":1.0,"source":"urfire_2022","dims":{"identification":"戴眼镜，声音低沉，初次见面觉得还不错，越接触越让人恶心","academics":"目前为止还没有给学生发过论文","funding":"据说已经把学院的经费用出了一个坑，填不回去了","stipend":"学校让发的还是会发","relationship":"师生关系极度恶劣，他的学生都想dasi他","workload":"他要求早8点半，晚11，无双休，呵呵，现在没人听他的","outcome":"直到离校那天，你都别想好过"}}],"alias":null}]}