chacha_2024","dims":{"description_raw":"我是本科选择的胡老师作为导师，字字真实。胡老师不但没有给我实验上任何指导，在论文写作上也没有，甚至到最后修改都不愿意过目，还说我是不是脑壳有问题？？？？我因得到的指导很少，自己摸索真的学到了很多，感谢胡老师的耐心指导。"}}],"alias":null},{"id":"ab6a919ef0","supervisor":"杨建东","university":"四川农业大学","dir_bucket":"未标注","departments":["动物科技学院"],"n_reviews":1,"rate_avg":1.25,"dates":["2019-08-01","2019-08-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{"outcome":2.0},"dims_n":{"outcome":1},"dims_ai":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":2.0,"base":2.0,"penalty":0,"penalties":[],"parts":[{"k":"sev","label":"七维口碑均分","v":2.0,"w":0.55}],"basis":"review","academics_profile":null,"outcome_profile":null,"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2019-08-01","rate":1.25,"source":"urfire_2022","dims":{"identification":"动科院6教","academics":"只知道学别人，所以完全不专业","funding":"学校低保户","stipend":"极低","relationship":"脾气还可以","outcome":"靠自己，半年换一次课题"}}],"alias":null},{"id":"aec95f5c2e","supervisor":"王之盛","university":"四川农业大学","dir_bucket":"未标注","departments":["动物营养研究所"],"n_reviews":1,"rate_avg":2.5,"dates":["2020-03-01","2020-03-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{"stipend":2.0,"outcome":1.0},"dims_n":{"stipend":1,"outcome":1},"dims_ai":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":1.5,"base":1.5,"penalty":0,"penalties":[],"parts":[{"k":"sev","label":"七维口碑均分","v":1.5,"w":0.55}],"basis":"review","academics_profile":null,"outcome_profile":null,"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2020-03-01","rate":2.5,"source":"urfire_2022","dims":{"academics":"吹牛一把手","funding":"三句不离钱","stipend":"200","relationship":"给个题目，放飞自我。","workload":"基本不在学校，也很少进实验室","outcome":"没啥前途，都去做销售了"}}],"alias":null},{"id":"a9023ab096","supervisor":"胡宗达","university":"四川农业大学","dir_bucket":"未标注","departments":["资源学院"],"n_reviews":1,"rate_avg":1.25,"dates":["2020-03-01","2020-03-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{"workload":1.0,"outcome":2.0},"dims_n":{"workload":1,"outcome":1},"dims_ai":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":1.5,"base":1.5,"penalty":0,"penalties":[],"parts":[{"k":"sev","label":"七维口碑均分","v":1.5,"w":0.55}],"basis":"review","academics_profile":null,"outcome_profile":null,"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2020-03-01","rate":1.25,"source":"urfire_2022","dims":{"identification":"云南口音，少数民族英语，油腻，抽烟","academics":"本科学英语的，但是英语真的很烂，几年发不出文章，发出的文章都是生态方向，而且自己又当一作又当通讯，明明是学生写的，自己吃干抹净。基本没有学术水平，本科生心中教书最烂老师之一","funding":"横向纵向都很少","stipend":"扣的很，让本科生跟着他去米亚罗也在出差一周，看到有卖橘子的，就给他老婆和女儿买了，两个本科生瓜起，回来给200","relationship":"论文排名不可能第一","workload":"打卡，随叫随到","outcome":"前途渺茫"}}],"alias":null},{"id":"a2c99ebdcd","supervisor":"饶HB","university":"四川农业大学","dir_bucket":"未标注","departments":["理学院"],"n_reviews":1,"rate_avg":1.75,"dates":["2019-12-01","2019-12-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{"relationship":2.0,"workload":2.0,"outcome":2.0},"dims_n":{"relationship":1,"workload":1,"outcome":1},"dims_ai":{},"internship":{"score":2,"pos":0,"neg":1},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":1.0,"base":2.0,"penalty":1,"penalties":[{"label":"不放实习/实习严重受限","pts":-1}],"parts":[{"k":"sev","label":"七维口碑均分","v":2.0,"w":0.55},{"k":"intern","label":"实习放行","v":2,"w":0.15}],"basis":"review","academics_profile":null,"outcome_profile":null,"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2019-12-01","rate":1.75,"source":"urfire_2022","dims":{"academics":"老师这实验室研究方向基本无指导能力，但手下有小老板指导，需要注意，学生需要自己看文献，想方案，做实验，写文章，投文章，改文章，这个老师基本帮不上忙，只会在旁边催，只是在投之前会让学生把论文发给他，他会找人改，最后一作肯定不是学生的。但好像也有一两篇一作给学生的，好像得凭学生能力了。这个老师只会说图好不好看，文献新不新。","funding":"实验室学生文章发的多，学校给的项目经费还算可以，加上他妻子也是实验室的老师（从没见过），中了个青基，这个青基也是学生写的。","stipend":"没有，为0","relationship":"实验室管理全靠学生，论文一作不给，杂活多，不考虑学生感受，每天看到他们实验室一个研三的一大早出门，大晚上回去，风雨无阻哈哈，老听他们实验室的抱怨老师老说他们不会做人哈哈…","workload":"指纹打卡，早8:30-晚10:30，没有周末和暑假，寒假会放几天","outcome":"不许实习，毕业前必须待实验室…"}}],"alias":null},{"id":"a3a43dbe7a","supervisor":"唐Q","university":"四川农业大学","dir_bucket":"未标注","departments":["园艺学院"],"n_reviews":2,"rate_avg":2.0,"dates":["2020-04-01","2020-05-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{"academics":5.0,"funding":3.5,"relationship":2.0},"dims_n":{"academics":1,"funding":2,"relationship":1},"dims_ai":{},"internship":{"score":2,"pos":0,"neg":1},"dropout":{"mentions":1,"hard":false,"keywords":{"延期毕业":1},"delay":1},"direction":null,"composite":0.65,"base":3.15,"penalty":2.5,"penalties":[{"label":"不放实习/实习严重受限","pts":-1},{"label":"延毕指控（博士）","pts":-1.5}],"parts":[{"k":"sev","label":"七维口碑均分","v":3.5,"w":0.55},{"k":"intern","label":"实习放行","v":2,"w":0.15},{"k":"dropout","label":"退学风险","v":3,"w":0.15}],"basis":"review","academics_profile":null,"outcome_profile":null,"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2020-05-01","rate":2.0,"source":"urfire_2022","dims":{"identification":"在七教的副院长办公室，是个看着比较气质的女教师，最大的特征是身边随时有只宠物狗形影不离。\\r","academics":"都在搞茶树栽培育种，有几个选育的茶树品种，时常下乡推广扶贫，文章并没见几篇，平时都是基础性研究，不好评价啥学术水平。\\r","funding":"科研经费算是充足，出差钱是给的多，就是很计较，一分一文都要能报销清楚，平时给学生补助的话听听就行了，尤其是做实验承诺的报酬数，基本不能当真。\\r","stipend":"据说最近几年已经有改善，但师生关系还是很紧张，平时对学生正常的时候不多，学生都是够尊敬她的，那给学生一些负责任的考虑不好吗，比如不要在节假日天天出差，不要总觉得学生不该回家。最典型的还是经常莫名其妙的被找麻烦，无视任何正当理由，一有差错全年挨骂，在她嘴里没有选择题，她说的事只要都依她就行，听话不一定好过，但不听话是肯定活不下去的。\\r","relationship":"实习是不能实习的，但工作总会有的，她会有针对性的推荐自己熟悉的岗位，更喜欢游说中意的学生读自己博，大家细品一下。\\r"}},{"date":"2020-04-01","rate":2.0,"source":"urfire_2022","dims":{"identification":"两年前搬到7教的副院长办公室，上了年纪的女老师，搞茶树栽培育种，本科生会喊唐嬢嬢，平时颇有气质，除课题组学生都喊她唐院长，跨个包家里养了个茶杯犬。","academics":"年轻时候发过一些论文，仅有一篇SCI还是别人带她的，上了年纪不懂分子实验。后来选育了几个茶树品种，研究的都是比较基础的茶树栽培，搞搞推广扶贫还行，上不了前沿的高度，真有学术追求的孩子请谨慎选择。","funding":"经费比上不足比下有余，在茶学系里面算高了，不过由于过多投入于大田试验和给农民工发补助，很难再投入到前沿的研究中去，极度警惕学生挪用经费。","stipend":"对学生比较抠，有时斤斤计较。虽然出差会给算真实天数，但有时给她办事会承诺给你点“辛苦费”，假吧意思很大方，但真正发到手的，完全抵不上付出的劳动，","relationship":"师生关系紧张，表面上风平浪静，实则暗潮涌动，学生十分警惕唐老师各种套路，会让你猝不及防，有时会秋后算账，新的旧的一起算，屁大点小事批得你怀疑人生，想要跳楼，对自己宽容，对学生严格的那种。优点就是会对本科生很好，给人一种错觉她是和蔼可亲的教授，在别人面前可劲儿夸自己的学生。","workload":"工作时间表面看起来宽松，但打电话给学生一堆杂事儿，拿快递，带狗，各种盖章报账，学生的实验看起来很关心，但一直自以为是的下定论，动不动让你重做，或要挟你延期毕业。平时出差压榨学生为主，特别喜欢周末出差过节出差，有些完全可以分几天做完，非要挤一天做（为节约差旅费），做慢了又怪学生动作慢，做快了还怪学生做不好没用心做。","outcome":"学生的工作还是很关心的，会推荐学生去一些认识的地方工作，也会催自己的学生读自己的博士（主要是用顺手了）。"}}],"alias":null},{"id":"aa5cebd7bd","supervisor":"徐ZW","university":"四川农业大学","dir_bucket":"其他学科（非AI）","departments":["动物医学院"],"n_reviews":1,"rate_avg":null,"dates":[null,null],"sources":["dachacha_2024"],"dims":{},"dims_n":{},"dims_ai":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":1,"hard":true,"keywords":{"退学":1},"delay":0},"direction":null,"composite":-4.0,"base":2.0,"penalty":6,"penalties":[{"label":"退学/劝退硬信号","pts":-6}],"parts":[{"k":"dropout","label":"退学风险","v":2,"w":0.15}],"basis":"review","academics_profile":null,"outcome_profile":null,"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":null,"rate":null,"source":"dachacha_2024","dims":{"description_raw":"我们每个人都有一颗退学的心"}}],"alias":null},{"id":"a9f4c3ea73","supervisor":"王雨林","university":"四川农业大学","dir_bucket":"其他学科（非AI）","departments":["管理学院"],"n_reviews":4,"rate_avg":1.12,"dates":["2019-04-01","2019-04-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{},"dims_n":{},"dims_ai":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywo