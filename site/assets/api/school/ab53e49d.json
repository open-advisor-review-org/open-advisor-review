，过节有时候会给研究生聚餐费用，老板自己一般不参加","relationship":"对学生挺好，有点护犊子，管理相对人性化，安排任务会提出要求限期完成，不会做一般不会挨骂，糊弄会挨收拾，自己没空时也会找学生跑腿，想混学位一般老板收拾得挺厉害。","workload":"正常工作时间，也会有希望假期学生能多留在学校学习的情况，但也让回家","outcome":"会允许学生到中科院等好单位实习，老师会帮助联系，但去私企挣小钱那就别想了，绝对不允许。会给学生推荐继续深造的导师，推荐工作，但能不能成基本靠自己。"}}],"alias":null},{"id":"a9f9dff7f4","supervisor":"朱松","university":"沈阳建筑大学","dir_bucket":"其他学科（非AI）","departments":["建筑与规划学院"],"n_reviews":1,"rate_avg":2.0,"dates":["2019-07-01","2019-07-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{"relationship":2.0},"dims_n":{"relationship":1},"dims_ai":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":2.0,"base":2.0,"penalty":0,"penalties":[],"parts":[{"k":"sev","label":"七维口碑均分","v":2.0,"w":0.55}],"basis":"review","academics_profile":null,"outcome_profile":null,"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2019-07-01","rate":2.0,"source":"urfire_2022","dims":{"identification":"我是他14年毕业的学生","academics":"平时没把精力放在学术上 我们都去他的公司干活","funding":"不知道","stipend":"一分没有","relationship":"全是活，就干吧，天天干到晚上，主要是放假不让走","workload":"早8晚10","outcome":"到哪都一样"}}],"alias":null},{"id":"a8a6a4983c","supervisor":"陈伯超","university":"沈阳建筑大学","dir_bucket":"其他学科（非AI）","departments":["建筑与规划学院"],"n_reviews":1,"rate_avg":4.25,"dates":["2019-05-01","2019-05-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{},"dims_n":{},"dims_ai":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":null,"base":null,"penalty":null,"penalties":[],"parts":[],"basis":null,"academics_profile":null,"outcome_profile":null,"synthesis":"该导师库内仅1条2019年评论，网评分4.25，样本极单一。评论只提及其年事已高、不再收学生，未评价学术水平、经费、补助、师生关系、工作强度、出路或实习支持，多维度保留为空。未出现退学、劝退、转导师或延毕等红线信号，也无同源重复评论可交叉验证；现有信息不足以形成稳定口碑判断。","freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier"