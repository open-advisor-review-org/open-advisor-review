es":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2019-10-01","rate":1.25,"source":"urfire_2022","dims":{"identification":"高壮，肚子大，略微秃顶，戴眼镜。祖籍山东，现居上海，无子女。热衷开会，洗脑。口头禅是，时间我是给你找不回来的。","academics":"多年没有发文章了，十年左右，对学生遇到的科研困难基本不指导","funding":"还行，能忽悠，还能拿点项目","stipend":"只有学校发，老师从未发过","relationship":"学生生病，这位老师说是实验做太少闲的，规律的熬夜就没问题，活多久都是天注定。随时想延毕学生，不管学生的付出","workload":"不打卡，但是随时找你谈话，007","outcome":"不允许实习，没时间准备考试和找工作工作情况很不好。"}},{"date":"2019-10-01","rate":0.5,"source":"urfire_2022","dims":{"identification":"A栋四楼 白高秃 山东","academics":"课题都是照搬发表的文章，或者拍脑袋想得，每个学生的课题各不相同，反正做不出来他就说是你能力不行，绝对不是自己学术水平的问题。“该帮你想得我都帮了，也不知道你运气咋这么不好。“","funding":"基于其夸夸其谈及爱面子的特质，偶尔还是能忽悠点经费的，也不知道那些评审委员有没有注意他这么多年没发文章这件事。","stipend":"农科院底薪，在上海，紧紧巴巴","relationship":"每周至少一次进展汇报，每次至少四个小时瞎逼逼，他饿了他就吃，才不管你饿不饿累不累。<br>发不出文章就算了，每次老师季度啊年底老师定计划时，还是吹自己一年要发十篇文章。没发出来就是因为招了一群没用的学生。<br>刚接触，你可能会被他画的大饼以及微笑赞美而心动，当你意识到他不过是想让你没日没夜加班工作，他就会变得凶神恶煞。反正他自己没人爱也必须要破坏你的生活。","workload":"996？不存在的。这里只有007。随时被喊去长谈 为他解闷。","outcome":"他衷心希望学生免费给他工作一辈子，希望每个学生都能延期并付诸实际行动。as you know,no paper no future."}}],"alias":null,"human_note":null},{"id":"a349b8fbb7","supervisor":"李呈军","university":"中国农业科学院","dir_bucket":"其他学科（非AI）","departments":["哈尔滨兽医研究所"],"n_reviews":2,"rate_avg":1.0,"dates":["2019-10-01","2020-03-01"],"sources":["urfire_2022"],"dims":{"outcome":1.0},"dims_n":{"outcome":1},"dims_ai":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":1.0,"base":1.0,"penalty":0,"penalties":[],"parts":[{"k":"sev","label":"七维口碑均分","v":1.0,"w":0.55}],"basis":"review","academics_profile":null,"outcome_profile":null,"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2020-03-01","rate":0.5,"source":"urfire_2022","dims":{"identification":"笑面虎，外人面前笑嘻嘻，人后骂人是一绝。","academics":"忙于行政，不在科研一线，学生自己做科研。","relationship":"压榨，夫妻店，跟自己媳妇在同一个实验室，只要发文章自己媳妇挂共一"}},{"date":"2019-10-01","rate":1.5,"source":"urfire_2022","dims":{"relationship":"千万别和自己过不去","workload":"有人累晕在实验室里","outcome":"呵呵"}}],"alias":null,"human_note":null},{"id":"a252c92a92","supervisor":"李JK","university":"中国农业科学院","dir_bucket":"未标注","departments":["蜜蜂研究所"],"n_reviews":5,"rate_avg":1.0,"dates":["2019-06-01","2019-08-01"],"sources":["urfire_2022"],"dims":{"relationship":2.0,"workload":2.0,"outcome":1.0},"dims_n":{"relationship":2,"workload":1,"outcome":3},"dims_ai":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":1,"hard":false,"keywords":{"转导师":1},"delay":0},"direction":null,"composite":0.45,"base":1.95,"penalty":1.5,"penalties":[{"label":"延毕指控（层级不明，按博士档）","pts":-1.5}],"parts":[{"k":"sev","label":"七维口碑均分","v":1.67,"w":0.55},{"k":"dropout","label":"退学风险","v":3,"w":0.15}],"basis":"review","academics_profile":null,"outcome_profile":null,"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2019-08-01","rate":1.0,"source":"urfire_2022","dims":{"identification":"办公室在农科院旧主楼","academics":"除了打质谱，其它都不懂，水平一般，平台也只能发低分文章，而且影响因子逐年下降。","funding":"应该够，可惜太抠门","stipend":"所里水平最低的，博士后一个月4000块钱。近站前说和员工一样，进去了才发现呵呵呵","relationship":"非常不好。家长封建式管理，成天叱骂，不知道老板成天哪来那么多负能量。实验室氛围压抑，长期下去会抑郁","workload":"从早到晚，晚上最好继续看文献写文章，周末是必须来实验室","outcome":"没什么前途。自寻出路。"}},{"date":"2019-08-01","rate":1.0,"source":"urfire_2022","dims":{"identification":"个高，总驼背","academics":"不怎么样，学识有限却总以为自己很牛，真是一身冷汗。总体来说，心性狭小，眼界低，格局小，没什么气量。心气倒是高，总想发一篇高分文章，然而完全没有自己的想法和思路，自己不努力，却总是寄希望于别人给他想课题和研究方法，成天白日做梦。","funding":"应该都有的，可惜太扣扣索索了，这也舍不得那也舍不得花，最好能不花钱做实验。","stipend":"所里最低水平了","relationship":"非常糟糕，净干些损人不利己的事情。没有一个能开开心心毕业走人的。还有些学生或者工作人员被赶走或者转导师了。记得曾经有一个考研没考上要调剂的女生，老板和她说只有她一个申请调剂到这里，女生家长高高兴兴给老板准备了礼，并且这个女生还放弃了其它的调剂的学校，结果最后老板要了另外一个男生。可惜了，被耽误了。老板的人品啊，总是这么的飘忽不定，上上下下，不过总是负数。和所里的每个老板关系都不好，以前实验室赶走几个工作人员和人才，后来这些工作人员和人才在所里自己成立了实验室，应该比他牛吧。完全不允许有自己的独立性。","workload":"每天来查岗，上午、中午、下午。有时候他自己下午溜出去一两个小时，回来的时候也会进实验室看看。","outcome":"和其它人说的一样，自寻出路吧。建议千万别来这个实验室，感觉一直在走下坡路，要走向末路了。"}},{"date":"2019-08-01","rate":1.0,"source":"urfire_2022","dims":{"identification":"办公室在农科院院子里，8号楼","academics":"之前有人评价过，基本属实","funding":"有的，不知道能维持几年。","stipend":"之前有人评价过，基本属实","relationship":"不太好。整个实验室氛围也不好。人很抠门，学生出差，每天100多块钱的补助，所里报销下来后，他都让课题组负责财务的，转到他自己的账户里。","workload":"早到晚归","outcome":"没什么前途吧，自己想办法吧。"}},{"date":"2019-08-01","rate":1.0,"source":"urfire_2022","dims":{"identification":"农科院西门旧主楼","academics":"上面说的属实","funding":"有的","stipend":"院里最低标准","relationship":"再补充一点，蜜蜂相关的一套书，蜂产品、花粉、蜂胶什么的，课题组每人分一本写，后来出版社给钱，据说有的师兄辛辛苦苦写的书，钱全被老板拿走了。人品有瑕，德不配位。院里应该健全导师的监督机制。","workload":"上面说的属实","outcome":"呃，没什么前途，能别来的就别来，只是晚几年找工作罢了"}},{"date":"2019-06-01","rate":1.0,"source":"urfire_2022","dims":{"identification":"河南人，个高，驼背，还有2年就该退休了吧。","academics":"长年低水平灌水文章，除了蛋白质组，其它什么也不懂，改文章只能改改句子语序之类的。却总吹牛自己多牛，可惜只能算算累计因子。一篇影响因子高点的文章都没有。在所里吹牛说要发大文章，年年夏天整个实验室所有人放下自己手头工作，组织大实验，结果年年做不出来想要的结果，只能寄希望于假数据，愁。还要求号召学生延期。","funding":"非常抠门，实验室连桶装水、卫生纸都舍不得买，自备吧。喝水烧自来水，水很脏。","stipend":"农科院所里最低补助。","relationship":"老板人品差，当年苦日子过过来的，总是念叨他当年吃不饱饭，成天饿肚子饿的头晕，要求每个学生必须学会养蜂，本质舍不得雇蜂农养蜂。实验室养蜂摇出来的蜂蜜全放他自己办公室，他自己偷偷卖掉，钱装自己口袋里。他的蜂蜜总是搀着卖，每年从外地蜂农买几大桶便宜的质量不好的稀蜜，然后卖给找上门的不明真相的人。夏天稀蜜放不住发酵，他就让学生给坏的蜂蜜加热后，分装继续卖。总把学生当他那个年代来训，发一分钱，恨不能十分讨回来。学生发的文章，老板拿奖金，学生一分钱分不到。他把所里其它课题组老板得罪了个遍，有时候去别的实验室借仪器都困难。","workload":"成天群里发鸡汤，号召加班做贡献，周末总让学生来实验室给他管理蜂群。","outcome":"大多去公司了，平台水平低没办法。"}}],"alias":null,"human_note":null},{"id":"a7ff2c54ea","supervisor":"张斌","university":"中国农业科学院","dir_bucket":"其他学科（非AI）","departments":["农业资源与农业区划研究所"],"n_reviews":1,"rate_avg":null,"dates":[null,null],"sources":["dachacha_2024"],"dims":{},"dims_n":{},"dims_ai":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":null,"base":null,"penalty":null,"penalties":[],"parts":[],"basis":null,"academics_profile":null,"outcome_profile":null,"synthesis":"库内仅1条评论，且内容为对楼上评论的调侃式反问——「楼上的，如果你被绑架了你就眨眨眼」，属于对他人评价真实性的质疑，并未提供关于导师学术、经费、补助、师生关系、工作强度、毕业去向或实习政策的任何实质信息。因此各维度均无有效证据，一律置空，不脑补、不以外推计分。该条不构成对导师的正面或负面判断，仅提示此页存在疑似被引导或失真的评论氛围；有效口碑样本为零，保留意见，判读结论待更多独立来源补充后再行更新。","freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":null,"rate":null,"source":"dachacha_2024","dims":{"description_raw":"楼上的，如果你被绑架了你就眨眨眼。"}}],"alias":null,"human_note":null}]}