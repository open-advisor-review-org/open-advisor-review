的用来买元器件，想尽一切办法为学生创造良好的科研条件","stipend":"发表高水平论文有奖","relationship":"对学生要求：身体第一，学习第二<br>有时候对学生关心过紧","workload":"一周六天","outcome":"不需要实习，对学生培养以实验与理论相辅相成，无限接近工程实际。"}}]},{"id":"a6bf5f0e2c","supervisor":"黄强","university":"重庆理工大学","dir_bucket":"其他学科（非AI）","departments":["机械工程学院"],"n_reviews":1,"rate_avg":1.75,"dates":["2020-03-01","2020-03-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{"workload":2.0,"outcome":1.0},"dims_n":{"workload":1,"outcome":1},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":1.5,"base":1.5,"penalty":0,"penalties":[],"parts":[{"k":"sev","label":"七维口碑均分","v":1.5,"w":0.55}],"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2020-03-01","rate":1.75,"source":"urfire_2022","dims":{"identification":"办公室在重庆理工大学第三实验楼301-4，重庆大学博士学历，教授，升高接近170厘米，50多岁了，也不接项目了，喜欢侃大山，买了一辆SUV车要跟学生说很多次，暗示自己懂车，给他夫人做了个几页的汇报PPT，结果夫人升职成功，这个事每次开会都会说一遍（暗示我们做的PPT不精练，抓不住重点）。一学期平均开会一次，不会像普通导师一样每周一次，属于散养型导师，学生不找他他就不会主动找学生，除非有事要学生办。要求极高及严格，学生得把事情做的很出色才行，不然就等着被骂，可能学生做的东西其他导师能打80分，他认为就值60分。个人认为指导能力一般般，学生自己搞的差不多了给提点建议，要是搞不出来找他那就是挨骂，经常说的一句话是：什么都没搞出来，没什么进度有什么好谈的，一句话可以把学生打发了。尤其喜欢抽烟，平时去他办公室开会，一会能抽好几支，而且还是开会过程中边讲话边抽，有女生在也抽，个人认为这个习惯很不好。","academics":"个人认为很一般，发的论文投的都是很普通的刊物。给出的指导意见非常普通，在逻辑思路方面挺不错，很严谨，这也是他的一个特征，非常注重逻辑。","funding":"没听说过有科研经费这个事，没项目，当然也不做实验，写论文需要的数据都是靠自己虚拟，没有实验支撑，当然也没有科研经费。","stipend":"我可以说不是正数，不是0，实验室打印机坏了找人修、买墨这些都是学生自己花钱，别想有报销这回事。三年时间没从导师这里拿到一分钱。","relationship":"这个就见仁见智了，个人认为导师与我们师兄师弟们关系都是表面维持状，每年新来一届学生邀请老师一起吃个饭都不去，我三年时间他只去过一次，当然毕业时邀请他去也不去，说是担心学校查谢师宴这些，这有腐败嫌疑？不知道用“两袖清风”形容他是不是合适。","workload":"工作时间也没硬性要求必须去实验室，也没要求打卡，当然他也不去实验室查岗什么的，三年时间他只去过实验室一次，我们实验室在蝴蝶山，他办公室在山下，不知道是不是这个原因。","outcome":"实习肯定不让去，用他的话来说是不建议去实习，实际上也就没人敢去了。得把自己搞的东西搞着差不多了才能去，前途这个就靠自己了，找到好工作的前途应该好点。"}}]},{"id":"a089573626","supervisor":"张志刚","university":"重庆理工大学","dir_bucket":"其他学科（非AI）","departments":["车辆工程学院"],"n_reviews":1,"rate_avg":null,"dates":["2020-03-01","2020-03-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{},"dims_n":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":null,"base":null,"penalty":null,"penalties":[],"parts":[],"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2020-03-01","rate":0.0,"source":"urfire_2022","dims":{"identification":"车院副院长，分管本科教学，本科上过他的汽车构造，不是他的研究生，人还不错，他有个女研究生(研究刹车片)去了上汽。"}}]},{"id":"a899890142","supervisor":"胡博","university":"重庆理工大学","dir_bucket":"其他学科（非AI）","departments":["车辆工程学院"],"n_reviews":1,"rate_avg":null,"dates":["2020-03-01","2020-03-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{},"dims_n":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":null,"base":null,"penalty":null,"penalties":[],"parts":[],"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2020-03-01","rate":0.0,"source":"urfire_2022","dims":{"identification":"重理工，英国巴斯硕博连读，全额奖学金。很年轻的老师，20年第一次找研究生。本科上过他的内燃机学，还分享了他在英国的趣事，老师很幽默。值得报考"}}]},{"id":"ab7b15948a","supervisor":"范兵","university":"重庆理工大学","dir_bucket":"其他学科（非AI）","departments":["化学化工学院"],"n_reviews":1,"rate_avg":1.0,"dates":["2020-03-01","2020-03-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{},"dims_n":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":null,"base":null,"penalty":null,"penalties":[],"parts":[],"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2020-03-01","rate":1.0,"source":"urfire_2022","dims":{"identification":"夏天穿拖鞋，时常一脸无懈的表情，秋天就穿件外套，里面撒子都不错，整个hmp形象","academics":"就发表一篇，还时常引以为傲，时常跟我们讲他受人排挤，说其他老师的文章都是假东西，只有他的是真的（当然也不是说其他老师一定就是真的），辣鸡学校水老师一大片","funding":"无","stipend":"无","relationship":"凡事上过他科的人，无不烦他，话说一句mmp，不知当讲不当讲","workload":"随时call你","outcome":"你废了"}}]}]}