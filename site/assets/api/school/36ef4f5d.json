{"meta":{"sid":"36ef4f5d","name":"江西科技师范大学","cate":"其他","n_advisors":6,"n_reviews":9,"n_scored":4,"avg_composite":2.38,"n_negative":0,"n_hardflag":0,"n_deep_done":0,"roster_total":null,"buckets":{"其他学科（非AI）":{"n_advisors":1,"n_scored":1,"n_reviews":1,"avg_composite":3.5,"n_negative":0,"n_deep_done":0},"未标注":{"n_advisors":5,"n_scored":3,"n_reviews":8,"avg_composite":2.0,"n_negative":0,"n_deep_done":0}},"ai":{"n_advisors":0,"n_scored":0,"n_reviews":0,"avg_composite":null,"n_negative":0,"n_deep_done":0}},"advisors":[{"id":"aa9b2c47d6","supervisor":"胡小强","university":"江西科技师范大学","dir_bucket":"其他学科（非AI）","departments":["教育学院"],"n_reviews":1,"rate_avg":1.0,"dates":["2018-01-01","2018-01-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{"workload":5.0,"outcome":2.0},"dims_n":{"workload":1,"outcome":1},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":3.5,"base":3.5,"penalty":0,"penalties":[],"parts":[{"k":"sev","label":"七维口碑均分","v":3.5,"w":0.55}],"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2018-01-01","rate":1.0,"source":"urfire_2022","dims":{"identification":"红角洲新校区，c栋，上至5楼左拐右手边第一个办公室就是他的，任教育学院副院长。口音，南昌人，平常运动喜欢打羽毛球，自称自己是长江学者，自称自己是江西做vr技术的第一人","academics":"此人原通信电子工程，后调至教育学院。研究方向虚拟现实，但其实一点虚拟现实技术也不会，甚至最基本的一些技术都不会，却一天到晚热衷参加各种学术论坛，目的就是为了合影拍照，晒自己出席多么高大上的技术，实际经常听座谈都是听到睡觉。所申请的个人主导项目多为3000经费左右，只是单纯随便抄抄写写一篇论文结题，甚至很多一直未能结题。经常挂嘴中的百万动漫项目，也是美术学院主导的，只是聘请他来凑个数而已，却不断被他当作炫耀资本。","funding":"有些忘记，根据学校规定，是每名研究生每年1800的经费貌似","stipend":"来实验室一天，给予5元一顿的餐补。除此以外无任何其他","relationship":"由于此人科研能力，出真正的科研成果可以说等同于零，故没有科研项目，有也就是三千经费的项目，成果就是一篇凑数的3000～1w字的省级文章发表。但是却依然要求所带学生全天候都去他给安排的指定办公室，俗称实验室。到了实验室就是帮他打杂。如果违背他的意思，他就会在论文开题，中期，送审各种需要签字的地方故意刁难你，百般折磨你。而且利欲熏心，每年都带学校规定的导师能带硕士生的最高人数。在研究生复试时就会主动联系学生，让其预选导师。但其实学校此时并未开始。由于新来学员不懂，看他热情会选他。后如果反悔，也只能打落牙齿肚里吞。所带的学生无不都恶心他，可是读书时却又没辙。曾经为难一个学生，开题中期各种刁难她不给签字，就是因为该学生偶尔不去实验室（真的没有项目啊，去实验室自习也就算了，可是是给他打杂啊。该生其实偶尔不来是去兼职了）。最后该生因为导师的长期刁难，又可能正好失恋，因为论文中期考核导师故意不给过，给逼到心里崩溃，最后被逼疯，送入了精神病医院。此人却推卸责任，说是学生心理承受能力太弱。","workload":"他希望周六日都不加班，甚至对学生说要在实验室过夜，买好泡面。可是没项目，真不知道待实验室干嘛，完全是控制欲","outcome":"不允许学生实习，把学生当作自己的奴隶一样，用做科研的名头要求学生必须待到毕业那一天。"}}]},{"id":"afd89000c3","supervisor":"顾兵","university":"江西科技师范大学","dir_bucket":"未标注","departments":["生命科学学院"],"n_reviews":2,"rate_avg":0.88,"dates":["2017-11-01","2018-02-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{"outcome":1.0,"workload":5.0},"dims_n":{"outcome":1,"workload":1},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":3.0,"base":3.0,"penalty":0,"penalties":[],"parts":[{"k":"sev","label":"七维口碑均分","v":3.0,"w":0.55}],"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2018-02-01","rate":1.0,"source":"urfire_2022","dims":{"academics":"上课不好好上，喜欢讲段子，实验室空空","funding":"穷的叮当响","stipend":"没有","relationship":"早毕业早超生，奇葩的存在","workload":"根本不管学生","outcome":"在他手下简直浪费，就是俩字 傻叉"}},{"date":"2017-11-01","rate":0.75,"source":"urfire_2022","dims":{"academics":"就没有学术水平，就是个混日子的货，没有自己的实验室，整天看别人做的然后推敲数据....","funding":"没钱，还扣的要死，说话不算话","relationship":"不想多评论","outcome":"毫无前途可言"}}]},{"id":"a229c461d3","supervisor":"曾斌","university":"江西科技师范大学","dir_bucket":"未标注","departments":["生命科学学院"],"n_reviews":2,"rate_avg":4.38,"dates":["2018-01-01","2018-04-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{"outcome":2.0},"dims_n":{"outcome":1},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":2.0,"base":2.0,"penalty":0,"penalties":[],"parts":[{"k":"sev","label":"七维口碑均分","v":2.0,"w":0.55}],"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2018-04-01","rate":5.0,"source":"urfire_2022","dim