"dachacha_2024","urfire_2022"],"dims":{"funding":4.0,"workload":3.5,"outcome":3.0,"relationship":2.5,"stipend":3.0},"dims_n":{"funding":2,"workload":2,"outcome":1,"relationship":2,"stipend":1},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":null,"composite":3.2,"base":3.2,"penalty":0,"penalties":[],"parts":[{"k":"sev","label":"七维口碑均分","v":3.2,"w":0.55}],"synthesis":null,"freshness":null,"notes":null,"tier":null,"research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2020-04-01","rate":5.0,"source":"urfire_2022","dims":{"identification":"胖胖哒很可爱","academics":"教授，博导，发过很多一区文章","funding":"省特聘教授，经费充足","stipend":"中等","relationship":"不错，可以为了学生做出牺牲","workload":"不算太长也不短","outcome":"还行，可以为了学生做出牺牲"}},{"date":"2019-12-01","rate":4.25,"source":"urfire_2022","dims":{"identification":"实验室在南林化工楼2211，办公室在隔壁。吐字较快，讲普通话，第一次接触可能跟不上他的语速，时间长习惯了就好了。","academics":"新加坡博后期间4篇JACS,回国后自己带领团队虽然没有JACS但是一区文章每年还是有保证的，比如近期的OL和GC。达到毕业要求的一篇sci还是很轻松的。","funding":"科研经费充足，老师的确会经常督促我们省着点用。","stipend":"目前硕士补助中规中矩，博士补助低。","relationship":"说实话，每个学生都抱怨过自己的导师。我承认我也在背后吐槽过。但是我还是想很客观的评价一下自己的导师，首先老师还是很负责任的，我们做实验每个人的核磁老师都会看，对于每个人的研究内容老师都了如指掌，出了问题老师也会帮忙解决。当然老师也有缺点，有时候会比较墨迹吧，有些事情会讲你n遍，脾气也有差的时候，会批评我们没有有机常识，文献读的少，emmmm。最后也希望想了解饶卫东可以组的同学能够理性认识这个网站，下面是知乎的连接，可以参考一下：https://www.zhihu.com/question/38910709","workload":"早上8：00-11：20左右<br>下午2：00-5 ：20左右<br>晚上6：30-9 ：30<br>每天大概工作10h，每周六天，周日休息。<br>寒暑假各三周。<br>平时各个节假日正常休息，如五一，十一等法定假日。","outcome":"一般自己可以找到工作，有需要可以向老师寻求帮助，目前毕业的师兄师姐都是靠自己就找到了心仪的工作，老师没有帮助。"}},{"date":"2019-12-01","rate":4.0,"source":"urfire_2022","dims":{"identification":"教授","academics":"水平挺高","funding":"很有钱也很扣","stipend":"不高","relationship":"一般，互相伤害，自己看着办","workload":"有空就去，一周最少六天","outcome":"自己找工作"}},{"date":"2019-12-01","rate":4.75,"source":"urfire_2022","dims":{"identification":"第一印象是个很有亲和力很好相处的老师，憨憨的不摆架子很客气，讲话语速快且带点口音。哈哈，相处之后才知道在涉及实验方面老师是有点啰嗦的。","academics":"每天都看化学相关期刊最新发表的科研成果，一心科研。目前手握四篇JACS和多篇其他一区文章，真的很热爱有机化学，每天都和学生聊实验，了解每个人的最新进度，帮助解决遇到的问题并指导下一步","funding":"作为南林引进的特聘教授，科研经费是不用担心的。在买试剂和仪器方面，老师比较舍得，好多仪器都是进口的。但平时也会强调不要奢侈，能省则省。","stipend":"在南林以及南京高校化学相关实验室中，研究生补助属于中等水平，目前博士可能偏低点","relationship":"在2211实验室，跟老师相处真的很简单，每天只要按照老师的计划完成任务就行。也很容易发文章，丝毫不用担心毕业，当然了不能太懒太水了","workload":"一周六天，早上八点半上班，晚上九点半下班，一天规定工作时间九个小时，不需要打卡，偶尔可以迟到偷溜。节假日自行放假，寒暑假各三周左右，平时有事容易请假。","outcome":"老师会提供一些帮助，但毕业的师兄师姐们都更喜欢自己找自己考，结果也都不错"}},{"date":"2019-09-01","rate":2.25,"source":"urfire_2022","dims":{"identification":"江苏省特聘教授，胖子，笑面虎","academics":"眼高手低，发文章拖拖拉拉","funding":"钱挺多，就是舍不得花，每天都会强调节省试剂耗材生怕学生浪费","stipend":"史上研究生最低工资记录保持者","relationship":"说话尖酸刻薄，永远认为学生有愧于自己","workload":"12*6","outcome":"自己找工作"}}],"alias":null},{"id":"ad46b917d8","supervisor":"刘云飞","university":"南京林业大学","dir_bucket":"电子信息/通信","departments":["信息科学技术学院"],"n_reviews":1,"rate_avg":1.0,"dates":["2017-05-01","2017-05-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{},"dims_n":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":{"score":3.0,"rationale":"批量规则锚点初评：无锚点命中取稳态默认；fit 未判定待复核（rubric v2.1）","basis":"anchor","discipline":"ai"},"composite":3.0,"base":3.0,"penalty":0,"penalties":[],"parts":[{"k":"direction","label":"方向前途(按AI)","v":3.0,"w":0.15}],"synthesis":null,"freshness":null,"notes":null,"tier":"cs_broad","research_status":null,"research_tier":null,"roster":null,"report":null,"reviews":[{"date":"2017-05-01","rate":1.0,"source":"urfire_2022","dims":{"academics":"还差，一辈子也没啥成就，仗着自己老婆在学校财务处，死抠门，学术费用都不知道用到哪里去了。绝对的人渣！"}}],"alias":null},{"id":"ab5643f4ea","supervisor":"张威","university":"南京林业大学","dir_bucket":"电子信息/通信","departments":["信息科学技术学院"],"n_reviews":1,"rate_avg":null,"dates":["2018-01-01","2018-01-01"],"sources":["dachacha_2024","urfire_2022"],"dims":{},"dims_n":{},"internship":{"score":null,"pos":0,"neg":0},"dropout":{"mentions":0,"hard":false,"keywords":{},"delay":0},"direction":{"score":3.0,"rationale":"批量规则锚点初评：无锚点命中取稳态默认；fit 未判定待复核（rubric v2.1）","basis":"anchor","